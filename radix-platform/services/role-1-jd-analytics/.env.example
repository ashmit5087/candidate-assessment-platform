# Copy to .env and fill in. Never commit .env.

# --- LLM (Google Gemini) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0
# --- Fallback LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
FALLBACK_TO_GROQ=true

# --- Universal Fallback LLM (OpenRouter Free Models) ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
FALLBACK_TO_OPENROUTER=true

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=10
MAX_EXTRACTED_TEXT_CHARS=60000
MAX_PDF_PAGES=200

# --- ChromaDB (local, persistent) ---
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=jd_chunks

# --- Embeddings (local, open source) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
JD_DATABASE_PATH=./data/jd_analyses.sqlite3
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=200

# --- Saved analyses storage: "sqlite" (local file, default) or "supabase" (shared database) ---
STORAGE_BACKEND=sqlite
# Only needed when STORAGE_BACKEND=supabase. The service-role key is a SECRET: backend only, never in a frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Browser access (React dev server origins, comma-separated) ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:5173
