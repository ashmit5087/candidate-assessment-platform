# Optional. The baseline needs no configuration and no API keys.
SKILL_MATCH_HOST=127.0.0.1
SKILL_MATCH_PORT=8005

# Optional LLM improvement-plan layer (off unless requested AND configured).
# Any OpenAI-compatible provider works; only these three values change.
# xAI Grok example:  LLM_BASE_URL=https://api.x.ai/v1
# Local Ollama:      LLM_BASE_URL=http://localhost:11434/v1  (LLM_API_KEY=ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20

# Universal Fallback LLM (OpenRouter Free Models)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
