# Service base URLs. Keep these blank until each backend is available at a
# distinct reachable URL. Do not put API keys or service credentials here.
VITE_JD_API_BASE_URL=
VITE_RESUME_API_BASE_URL=
VITE_PROFILE_API_BASE_URL=
VITE_TALENT_CHECK_API_BASE_URL=
VITE_SKILL_MATCH_API_BASE_URL=

# Demo mode must be explicitly enabled and is not intended for production.
VITE_DEMO_MODE=false

# Authentication is not selected yet. This only controls provider-neutral UI.
VITE_AUTH_MODE=demo

# Role 3's actual profile schema must be confirmed before live create/update.
VITE_PROFILE_CONTRACT_CONFIRMED=false
