{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RADIX Role 5 - Skill Matching contract",
  "description": "Generated from apps/skill_matching schemas.py. Request: POST /api/v1/matches. Required response fields: jd_source_file, match_score, matched_skills, missing_skills.",
  "request": {
    "$defs": {
      "CandidateProfile": {
        "description": "Role 3 profile or Role 2 resume skill list. Only `skills` is used.",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Name"
          },
          "skills": {
            "items": {
              "$ref": "#/$defs/Skill"
            },
            "title": "Skills",
            "type": "array"
          }
        },
        "title": "CandidateProfile",
        "type": "object"
      },
      "JobDescription": {
        "description": "Role 1 JD skill list.",
        "properties": {
          "source_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "jd",
            "title": "Source Type"
          },
          "source_file": {
            "default": "",
            "title": "Source File",
            "type": "string"
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Company"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Role"
          },
          "skills": {
            "items": {
              "$ref": "#/$defs/Skill"
            },
            "title": "Skills",
            "type": "array"
          }
        },
        "required": [
          "skills"
        ],
        "title": "JobDescription",
        "type": "object"
      },
      "Skill": {
        "description": "Shared skill object (brief page 9).",
        "properties": {
          "skill_name": {
            "title": "Skill Name",
            "type": "string"
          },
          "category_code": {
            "default": "OTHER",
            "enum": [
              "COD",
              "DSA",
              "OOD",
              "APTI",
              "COMM",
              "AI",
              "CLOUD",
              "SQL",
              "SWE",
              "SYSD",
              "NETW",
              "OS",
              "OTHER"
            ],
            "title": "Category Code",
            "type": "string"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evidence"
          },
          "confidence": {
            "anyOf": [
              {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Confidence"
          },
          "importance": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Importance"
          }
        },
        "required": [
          "skill_name"
        ],
        "title": "Skill",
        "type": "object"
      }
    },
    "properties": {
      "candidate": {
        "$ref": "#/$defs/CandidateProfile"
      },
      "job_description": {
        "$ref": "#/$defs/JobDescription"
      }
    },
    "required": [
      "candidate",
      "job_description"
    ],
    "title": "MatchRequest",
    "type": "object"
  },
  "response": {
    "$defs": {
      "ScoreBreakdown": {
        "properties": {
          "scoring_method": {
            "title": "Scoring Method",
            "type": "string"
          },
          "matched_weight": {
            "title": "Matched Weight",
            "type": "number"
          },
          "partial_weight": {
            "title": "Partial Weight",
            "type": "number"
          },
          "review_required_weight": {
            "title": "Review Required Weight",
            "type": "number"
          },
          "missing_weight": {
            "title": "Missing Weight",
            "type": "number"
          },
          "total_required_weight": {
            "title": "Total Required Weight",
            "type": "number"
          },
          "formula": {
            "title": "Formula",
            "type": "string"
          },
          "weighting": {
            "title": "Weighting",
            "type": "string"
          }
        },
        "required": [
          "scoring_method",
          "matched_weight",
          "partial_weight",
          "review_required_weight",
          "missing_weight",
          "total_required_weight",
          "formula",
          "weighting"
        ],
        "title": "ScoreBreakdown",
        "type": "object"
      },
      "SkillResult": {
        "description": "One JD requirement, fully accounted for.",
        "properties": {
          "skill_name": {
            "title": "Skill Name",
            "type": "string"
          },
          "category_code": {
            "enum": [
              "COD",
              "DSA",
              "OOD",
              "APTI",
              "COMM",
              "AI",
              "CLOUD",
              "SQL",
              "SWE",
              "SYSD",
              "NETW",
              "OS",
              "OTHER"
            ],
            "title": "Category Code",
            "type": "string"
          },
          "status": {
            "enum": [
              "matched",
              "partial",
              "missing",
              "review_required"
            ],
            "title": "Status",
            "type": "string"
          },
          "candidate_skill": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Candidate Skill"
          },
          "candidate_skills_considered": {
            "items": {
              "type": "string"
            },
            "title": "Candidate Skills Considered",
            "type": "array"
          },
          "jd_evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Jd Evidence"
          },
          "candidate_evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Candidate Evidence"
          },
          "candidate_evidence_present": {
            "default": false,
            "title": "Candidate Evidence Present",
            "type": "boolean"
          },
          "jd_confidence": {
            "anyOf": [
              {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Jd Confidence"
          },
          "candidate_confidence": {
            "anyOf": [
              {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Candidate Confidence"
          },
          "match_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Match Method"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          },
          "contribution": {
            "title": "Contribution",
            "type": "number"
          }
        },
        "required": [
          "skill_name",
          "category_code",
          "status",
          "rationale",
          "weight",
          "contribution"
        ],
        "title": "SkillResult",
        "type": "object"
      }
    },
    "properties": {
      "jd_source_file": {
        "title": "Jd Source File",
        "type": "string"
      },
      "match_score": {
        "maximum": 100,
        "minimum": 0,
        "title": "Match Score",
        "type": "integer"
      },
      "matched_skills": {
        "items": {
          "$ref": "#/$defs/SkillResult"
        },
        "title": "Matched Skills",
        "type": "array"
      },
      "missing_skills": {
        "items": {
          "$ref": "#/$defs/SkillResult"
        },
        "title": "Missing Skills",
        "type": "array"
      },
      "company": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Company"
      },
      "role": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Role"
      },
      "partial_matches": {
        "items": {
          "$ref": "#/$defs/SkillResult"
        },
        "title": "Partial Matches",
        "type": "array"
      },
      "review_required": {
        "items": {
          "$ref": "#/$defs/SkillResult"
        },
        "title": "Review Required",
        "type": "array"
      },
      "score_breakdown": {
        "$ref": "#/$defs/ScoreBreakdown"
      },
      "summary": {
        "title": "Summary",
        "type": "string"
      },
      "algorithm_version": {
        "title": "Algorithm Version",
        "type": "string"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      },
      "disclaimer": {
        "default": "Decision support only: this score reflects skill-name/alias overlap between two upstream extractions, not a judgment of a person's ability.",
        "title": "Disclaimer",
        "type": "string"
      }
    },
    "required": [
      "jd_source_file",
      "match_score",
      "matched_skills",
      "missing_skills",
      "score_breakdown",
      "summary",
      "algorithm_version"
    ],
    "title": "MatchResponse",
    "type": "object"
  }
}
